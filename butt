1. Convert a user-input into all caps, print the result.

FUNCTION to_uppercase(input_string)
    SET result_string TO ""

    FOR EACH character IN input_string
        SET ascii_value TO GET _ASCII(character)

        IF ascii_value >= 97 AND ascii_value <= 122 THEN
            # Subtract 32 to move from lowercase to uppercase
            SET new_ascii TO ascii_value - 32
            APPEND CONVET_TO_CHAR(new_ascii) TO result_string
        ELSE
            # Keep digits, symbols, or existing capitals as they are
            APPEND character TO result_string
        END IF
    END FOR
    RETURN result_string
END FUNCTION



